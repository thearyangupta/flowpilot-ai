APP_NAME=FlowPilot AI
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flowpilot
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flowpilot_test

POSTGRES_USER=flowpilot
POSTGRES_DB=flowpilot
POSTGRES_PASSWORD=replace_me

REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1

GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.5-flash

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=replace_with_your_google_callback_uri

STREAMLIT_APP_URL=http://localhost:8501

GMAIL_POLL_QUERY=is:unread

JWT_SECRET=replace_me
JWT_ISSUER=flowpilot-api
JWT_AUDIENCE=flowpilot-client
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15

TOKEN_ENCRYPTION_KEYS=replace_me
REDIS_RATE_LIMIT_URL=redis://localhost:6379/2
EXECUTION_CREATE_RATE_LIMIT=10
EXECUTION_CREATE_RATE_WINDOW_SECONDS=60